# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated dev-fallback seed images (run `npm run seed` to (re)generate from
# a local folder of photos — never committed, can be large binary WebP files).
# lib/data/fallback/*.json IS tracked: it ships with safe empty defaults so a
# fresh clone builds without a seed step, and `npm run seed` overwrites it
# locally with your real photo metadata — commit that update if you want the
# seeded dataset to ship with the repo, or leave it uncommitted otherwise.
/public/seed/
